# Copiar como .env y ajustar segun el ambiente
BASE_URL=https://demowebshop.tricentis.com/
HEADLESS=true
SLOW_MO=0
DEFAULT_TIMEOUT=15000

# Opcional: reutilizar un navegador ya instalado (chrome | msedge)
# en lugar del Chromium que descarga Playwright.
BROWSER_CHANNEL=

# VIDEO=off desactiva la grabacion (evita depender del binario ffmpeg)
VIDEO=
